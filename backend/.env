# ──────────────────────────────────────────────────────────────────────────────
# JAL Backend — Environment Variables
# Copy this file to  backend/.env  and fill in the values.
# The .env file is git-ignored and should NEVER be committed.
# ──────────────────────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────────────────────
# 🔑  OpenAI API Key  (REQUIRED)
# ──────────────────────────────────────────────────────────────────────────────
#
#  1. Go to https://platform.openai.com/api-keys
#  2. Create a new secret key
#  3. Paste it below — replace  YOUR_API_KEY_HERE
#
OPENAI_API_KEY=API_KEY_HERE
# ──────────────────────────────────────────────────────────────────────────────
# 🤖  OpenAI Model  (optional — default: gpt-4o-mini)
# ──────────────────────────────────────────────────────────────────────────────
# Other options: gpt-4o, gpt-3.5-turbo
#
OPENAI_MODEL=gpt-4o-mini

# ──────────────────────────────────────────────────────────────────────────────
# 🎬  Magic Hour API Key  (REQUIRED for real video generation)
# ──────────────────────────────────────────────────────────────────────────────
#
#  1. Go to https://magichour.ai → Account → API Keys
#  2. Create a new key and paste it below
#
MAGIC_HOUR_API_KEY=YOUR_MAGIC_HOUR_KEY_HERE

# ──────────────────────────────────────────────────────────────────────────────
# 🖥️  Server Configuration  (optional)
# ──────────────────────────────────────────────────────────────────────────────
# PORT=3001
# CORS_ORIGIN=http://localhost:5173
