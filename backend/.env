# ──────────────────────────────────────────────────────────────────────────────
# JAL Backend — Environment Variables
# Copy this file to  backend/.env  and fill in the values.
# The .env file is git-ignored and should NEVER be committed.
# ──────────────────────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────────────────────
# 🔑  OpenAI API Key  (REQUIRED)
# ──────────────────────────────────────────────────────────────────────────────
#
#  1. Go to https://platform.openai.com/api-keys
#  2. Create a new secret key
#  3. Paste it below — replace  YOUR_API_KEY_HERE
#
OPENAI_API_KEY=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

# ──────────────────────────────────────────────────────────────────────────────
# 🤖  OpenAI Model  (optional — default: gpt-4o-mini)
# ──────────────────────────────────────────────────────────────────────────────
# Other options: gpt-4o, gpt-3.5-turbo
#
OPENAI_MODEL=gpt-4o-mini

# ──────────────────────────────────────────────────────────────────────────────
# 🖥️  Server Configuration  (optional)
# ──────────────────────────────────────────────────────────────────────────────
