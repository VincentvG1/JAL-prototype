# ─────────────────────────────────────────────────────────────────
# JAL-Prototype — Environment Variables
# Copy this file to .env.local and fill in your keys.
# Never commit .env.local to Git.
# ─────────────────────────────────────────────────────────────────

# Groq — used by /api/coach to evaluate and enhance prompts
# Free tier available. Get your key at:
# https://console.groq.com → API Keys → Create API Key
GROQ_API_KEY=gsk_...

# Magic Hour — used by /api/generate to create videos with LTX-2.3
# Free tier available (no credit card required).
# Get your key at:
# https://magichour.ai/settings/developer → Generate API Key
MAGIC_HOUR_API_KEY=mhk_live_...
